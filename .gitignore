# ---- Secrets (NEVER commit) ----
ai/key.sh
.env
*.env
*.pem
*.key
id_rsa*
**/secrets.*

# ---- Python ----
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
.pytest-flex-modules/

# ---- Node / UI ----
node_modules/
ui/dist/
*.tsbuildinfo

# ---- Java / Maven ----
.m2/
target/
# Local Maven settings (internal mirror creds / URLs); example is committed.
flex/connector/maven-settings.xml

# ---- Local dev overrides (host-specific compose tweaks) ----
datapro/docker-compose.override.yml

# ---- Runtime / generated ----
.dev-logs/
# Per-run perf artifacts; the committed baseline lives under tests/perf/baselines/
core/.perf-results/
# Core materializes flex module .py files here at runtime
datapro/flex-modules/*.py
# Git worktrees created by scripts/create-worktree.sh (nested checkouts)
.worktrees/

# ---- OS / editor ----
.DS_Store
*.swp
.idea/
.vscode/

# ---- Local Claude settings (keep CLAUDE.md, drop local overrides) ----
.claude/settings.local.json

# ---- Datasets: large third-party downloaded/extracted data (49GB).
#      Keep only the small scaffolding (compose, scripts, docs). ----
datasets/**
!datasets/**/
!datasets/**/*.md
!datasets/**/*.yml
!datasets/**/*.yaml
!datasets/**/*.sh
!datasets/**/*.sql
!datasets/**/*.py
!datasets/**/*.toml
!datasets/**/Dockerfile
!datasets/**/.gitignore
